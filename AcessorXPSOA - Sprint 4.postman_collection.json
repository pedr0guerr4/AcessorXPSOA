				{
					"name": "Login (gera JWT e salva em {{token}})",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function () { pm.response.to.have.status(200); });",
									"const json = pm.response.json();",
									"pm.collectionVariables.set('token', json.token);",
									"pm.test('Token definido', function () { pm.expect(pm.collectionVariables.get('token')).to.be.a('string').and.not.empty; });"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Autentica e armazena o token JWT na variável de coleção {{token}}."
					},
					"response": []
				}
			]
